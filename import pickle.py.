import json
import pickle
import os
from abc import ABC, abstractmethod


# Абстракция
class Person(ABC):
    def __init__(self, name):
        self._name = name

    @abstractmethod
    def get_role(self):
        pass


# Инкапсуляция
class Book:
    def __init__(self, title, author, available=True):
        self._title = title
        self._author = author
        self._available = available

    @property
    def title(self):
        return self._title

    @property
    def author(self):
        return self._author

    @property
    def available(self):
        return self._available

    def borrow(self):
        if self._available:
            self._available = False
            return True
        return False

    def return_book(self):
        self._available = True


# Наследование
class User(Person):
    def __init__(self, name, user_id):
        super().__init__(name)
        self._user_id = user_id
        self._borrowed = []

    def get_role(self):
        return "Пользователь"

    @property
    def user_id(self):
        return self._user_id

    @property
    def borrowed_books(self):
        return self._borrowed

    def borrow_book(self, title):
        self._borrowed.append(title)

    def return_book(self, title):
        if title in self._borrowed:
            self._borrowed.remove(title)


class Librarian(Person):
    def __init__(self, name, emp_id):
        super().__init__(name)
        self._emp_id = emp_id

    def get_role(self):
        return "Библиотекарь"

    @property
    def emp_id(self):
        return self._emp_id


# Основной класс
class Library:
    def __init__(self):
        self.books = {}
        self.users = {}
        self.librarians = {}
        self.load_data()  # Загружаем данные при создании
        
        # Добавляем библиотекаря-админа, если его нет
        if "lib1" not in self.librarians:
            self.librarians["lib1"] = Librarian("Админ", "lib1")

    def add_book(self, title, author):
        if title not in self.books:
            self.books[title] = Book(title, author)
            self.save_data()  # Сохраняем после добавления
            return True
        return False

    def remove_book(self, title):
        if title in self.books and self.books[title].available:
            del self.books[title]
            self.save_data()  # Сохраняем после удаления
            return True
        return False

    def register_user(self, name, user_id):
        if user_id not in self.users:
            self.users[user_id] = User(name, user_id)
            self.save_data()  # Сохраняем после регистрации
            return True
        return False

    def borrow_book(self, user_id, title):
        if user_id not in self.users or title not in self.books:
            return "Не найдено"
        if not self.books[title].available:
            return "Уже выдана"

        self.books[title].borrow()
        self.users[user_id].borrow_book(title)
        self.save_data()  # Сохраняем после выдачи
        return "Успешно"

    def return_book(self, user_id, title):
        if user_id not in self.users or title not in self.books:
            return "Не найдено"
        if self.books[title].available:
            return "Уже в библиотеке"

        self.books[title].return_book()
        self.users[user_id].return_book(title)
        self.save_data()  # Сохраняем после возврата
        return "Успешно"

    def save_data(self):
        """Сохранение данных в файл с помощью pickle"""
        try:
            # Подготавливаем данные для сериализации
            data = {
                'books': [],
                'users': [],
                'librarians': []
            }
            
            # Сохраняем книги
            for title, book in self.books.items():
                data['books'].append({
                    'title': book.title,
                    'author': book.author,
                    'available': book.available
                })
            
            # Сохраняем пользователей
            for user_id, user in self.users.items():
                data['users'].append({
                    'name': user._name,
                    'user_id': user.user_id,
                    'borrowed': user.borrowed_books.copy()
                })
            
            # Сохраняем библиотекарей
            for emp_id, librarian in self.librarians.items():
                data['librarians'].append({
                    'name': librarian._name,
                    'emp_id': librarian.emp_id
                })
            
            # Записываем в файл
            with open('library_data.pkl', 'wb') as f:
                pickle.dump(data, f)
            
            print("Данные успешно сохранены")
            
        except Exception as e:
            print(f"Ошибка при сохранении данных: {e}")

    def load_data(self):
        """Загрузка данных из файла с помощью pickle"""
        try:
            if os.path.exists('library_data.pkl'):
                with open('library_data.pkl', 'rb') as f:
                    data = pickle.load(f)
                
                # Очищаем текущие данные
                self.books = {}
                self.users = {}
                self.librarians = {}
                
                # Загружаем книги
                for book_data in data.get('books', []):
                    book = Book(
                        book_data['title'],
                        book_data['author'],
                        book_data['available']
                    )
                    self.books[book_data['title']] = book
                
                # Загружаем пользователей
                for user_data in data.get('users', []):
                    user = User(user_data['name'], user_data['user_id'])
                    # Восстанавливаем список взятых книг
                    for borrowed_book in user_data.get('borrowed', []):
                        user.borrow_book(borrowed_book)
                    self.users[user_data['user_id']] = user
                
                # Загружаем библиотекарей
                for lib_data in data.get('librarians', []):
                    librarian = Librarian(lib_data['name'], lib_data['emp_id'])
                    self.librarians[lib_data['emp_id']] = librarian
                
                print("Данные успешно загружены")
                return True
            else:
                print("Файл с данными не найден. Созданы тестовые данные.")
                self.create_test_data()
                return False
                
        except Exception as e:
            print(f"Ошибка при загрузке данных: {e}")
            print("Созданы тестовые данные.")
            self.create_test_data()
            return False
    
    def create_test_data(self):
        """Создание тестовых данных при первом запуске"""
        self.add_book("Бедная Лиза", "Карамзин")
        self.add_book("Мастер и Маргарита", "Булгаков")
        self.add_book("Война и мир", "Толстой")
        self.register_user("Икогнито", "user1")
        self.register_user("Мария Иванова", "user2")
        # Библиотекарь-админ создается в __init__


# Интерфейс
