        print("=" * 30)
        print("1. Вход для библиотекаря")
        print("2. Вход для пользователя")
        print("3. Выход")
        choice = input("Ваш выбор: ")

        if choice == "1":
            emp_id = input("Введите ID сотрудника: ")
            if emp_id in self.lib.librarians:
                self.current_user = self.lib.librarians[emp_id]
                self.current_role = "librarian"
                print(f"\nДобро пожаловать, {self.current_user._name}!")
            else:
                print("\nБиблиотекарь с таким ID не найден!")

        elif choice == "2":
            print("\n1. Войти в существующий аккаунт")
            print("2. Зарегистрировать новый аккаунт")
            sub = input("Ваш выбор: ")
            
            if sub == "1":
                uid = input("Введите ID пользователя: ")
                if uid in self.lib.users:
                    self.current_user = self.lib.users[uid]
                    self.current_role = "user"
                    print(f"\nДобро пожаловать, {self.current_user._name}!")
                else:
                    print("\nПользователь с таким ID не найден!")
            elif sub == "2":
                print("\nОбратитесь к библиотекарю для регистрации")
            else:
                print("\nНеверный выбор!")

        elif choice == "3":
            print("\nСохраняем данные перед выходом...")
            self.lib.save_data()
            print("До свидания!")
            exit()
        else:
            print("\nНеверный выбор!")

