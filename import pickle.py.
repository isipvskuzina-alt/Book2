        else:
            print(f"Книга '{title}' уже существует!")

    def remove_book(self):
        print("\n--- УДАЛЕНИЕ КНИГИ ---")
        title = input("Название книги: ")
        if self.lib.remove_book(title):
            print(f"Книга '{title}' успешно удалена!")
        else:
            print(f"Книга '{title}' не найдена или находится у читателя!")

    def register_user(self):
        print("\n--- РЕГИСТРАЦИЯ ПОЛЬЗОВАТЕЛЯ ---")
        name = input("Имя пользователя: ")
        uid = input("ID пользователя: ")
        if self.lib.register_user(name, uid):
            print(f"Пользователь '{name}' с ID '{uid}' успешно зарегистрирован!")
        else:
            print(f"Пользователь с ID '{uid}' уже существует!")

    def list_users(self):
        print("\n" + "=" * 50)
        print("СПИСОК ПОЛЬЗОВАТЕЛЕЙ")
        print("=" * 50)
        if not self.lib.users:
            print("Нет зарегистрированных пользователей")
        else:
            for user in self.lib.users.values():
                books = ", ".join(user.borrowed_books) if user.borrowed_books else "нет книг"
                print(f"📚 {user._name} (ID: {user.user_id}) | Взято книг: {len(user.borrowed_books)} | Список: {books}")
        print("=" * 50)

    def list_books(self):
        print("\n" + "=" * 50)
        print("СПИСОК ВСЕХ КНИГ")
        print("=" * 50)
        if not self.lib.books:
            print("В библиотеке нет книг")
        else:
            for book in self.lib.books.values():
                status = "✓ ДОСТУПНА" if book.available else "✗ ВЫДАНА"
                print(f"📖 {book.title} - {book.author} [{status}]")
        print("=" * 50)

    # Методы пользователя
    def show_available(self):
        print("\n" + "=" * 50)
        print("ДОСТУПНЫЕ КНИГИ")
        print("=" * 50)
        available = [b for b in self.lib.books.values() if b.available]
        if available:
            for book in available:
                print(f"📖 {book.title} - {book.author}")
        else:
            print("Нет доступных книг")
        print("=" * 50)

    def borrow_book(self):
        print("\n--- ВЗЯТЬ КНИГУ ---")
        title = input("Название книги: ")
        result = self.lib.borrow_book(self.current_user.user_id, title)
        print(result)
        if result == "Успешно":
            print(f"Вы успешно взяли книгу '{title}'")

    def return_book(self):
        print("\n--- ВЕРНУТЬ КНИГУ ---")
        title = input("Название книги: ")
        result = self.lib.return_book(self.current_user.user_id, title)
        print(result)
        if result == "Успешно":
            print(f"Вы успешно вернули книгу '{title}'")

    def my_books(self):
        print("\n" + "=" * 50)
        print(f"КНИГИ ПОЛЬЗОВАТЕЛЯ: {self.current_user._name}")
        print("=" * 50)
        books = self.current_user.borrowed_books
        if books:
            for i, book in enumerate(books, 1):
                print(f"{i}. {book}")
        else:
            print("У вас нет взятых книг")
        print("=" * 50)

    def logout(self):
        self.current_user = None
        self.current_role = None
        print("\nВы успешно вышли из аккаунта!")


